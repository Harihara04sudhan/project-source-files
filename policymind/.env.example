# Copy to .env and fill in. .env is gitignored — never commit real values.

# Postgres (Neon recommended; any Postgres URL works).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# OpenAI key for the policy drafter. ANTHROPIC_API_KEY is also supported —
# swap the import in src/lib/drafter.ts if you prefer Claude.
OPENAI_API_KEY=""

# Telegram bot — OPTIONAL. Only needed if you want digest cards pushed to
# Telegram subscribers via `npm run telegram:bot`. The web dashboard, the
# /agent flow, ratify, and the ArmorPolicy promotion path all work without it.
# Leave blank to skip Telegram push entirely.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Public dashboard URL — used in Telegram messages and inline buttons.
# Localhost works for local dev; deploy this to a public URL to get the
# "View in dashboard" inline button on cards.
POLICYMIND_BASE_URL="http://localhost:3000"

# Cluster threshold for the drafter. Default 3.
POLICYMIND_CLUSTER_THRESHOLD=3
POLICYMIND_OVERRIDE_RELAX_THRESHOLD=5
POLICYMIND_ORG_ID="demo-org"

# Live ArmorPolicy promotion. With these set, every ratification mints a
# signed intent token at /iap/sdk/token and stores plan_id + intent_reference
# + plan_hash + merkle_root on the ratified row. Leave empty to run in
# local-ledger demo mode.
#
#   ak_live_*  -> ARMORPOLICY_API_BASE=https://api.armoriq.ai
#   ak_claw_*  -> ARMORPOLICY_API_BASE=https://armorpolicy-api.armoriq.ai
ARMORPOLICY_API_BASE=""
ARMORPOLICY_PROXY_BASE="https://proxy.armoriq.ai"
ARMORPOLICY_API_KEY=""
ARMORPOLICY_USER_ID="policymind-demo-user"
ARMORPOLICY_AGENT_ID="policymind-drafter"
ARMORPOLICY_CONTEXT_ID="default"
